# Signing material — never committed; only via GitHub Actions secrets
*.jks
*.keystore
keystore.properties
# Exception: the debug-only keystore is intentionally committed for a stable, CI-reproducible
# SHA-1 (needed for Google Sign-In's Android OAuth client). Its password is Android's own
# public, standard debug credential ("android"/"android") — there is no real secret here.
!android/app/debug.keystore

# CI build output downloaded locally
apk-output/

# Local build/server logs
android/build_log.txt
download/server.log

# Misc
.DS_Store

.vercel
